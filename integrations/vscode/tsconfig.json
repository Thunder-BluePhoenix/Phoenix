{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2024"],
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["extension.js", "src/**/*.js", "scripts/**/*.js", "types/**/*.d.ts"]
}
