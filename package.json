{
  "name": "phoenix",
  "version": "0.0.0",
  "private": true,
  "description": "Phoenix — open-source developer companion platform. Fawkes is the pet.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:core": "tsx core/runtime/src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "node scripts/check-license-headers.mjs && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "dev:web": "pnpm --filter @phoenix/web dev",
    "build:web": "pnpm --filter @phoenix/web build",
    "start": "pnpm build:web && pnpm dev:core",
    "simulate": "tsx sdk/testing/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
