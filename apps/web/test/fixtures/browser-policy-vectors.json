  "permissions": [
    {
      "name": "default deny",
      "grants": [],
      "ask": { "kind": "microphone", "top": "https://example.com", "frame": "https://example.com" },
      "expect": { "verdict": "deny", "reason": "default_deny" }
    },
    {
      "name": "unknown kind",
      "grants": [],
      "ask": { "kind": "teleport", "top": "https://example.com", "frame": "https://example.com" },
      "expect": { "verdict": "deny", "reason": "unknown_kind" }
    },
    {
      "name": "grant without gesture is ignored",
      "grants": [{ "origin": "https://example.com", "kind": "camera", "gesture": false }],
      "ask": { "kind": "camera", "top": "https://example.com", "frame": "https://example.com" },
      "expect": { "verdict": "deny", "reason": "default_deny" }
    },
    {
      "name": "granted pair",
      "grants": [{ "origin": "https://example.com", "kind": "microphone", "gesture": true }],
      "ask": { "kind": "microphone", "top": "https://example.com", "frame": "https://example.com" },
      "expect": { "verdict": "allow", "reason": "granted" }
    },
    {
      "name": "other kind stays denied",
      "grants": [{ "origin": "https://example.com", "kind": "microphone", "gesture": true }],
      "ask": { "kind": "camera", "top": "https://example.com", "frame": "https://example.com" },
      "expect": { "verdict": "deny", "reason": "default_deny" }
    },
    {
      "name": "subdomain does not inherit",
      "grants": [{ "origin": "https://example.com", "kind": "microphone", "gesture": true }],
      "ask": {
        "kind": "microphone",
        "top": "https://www.example.com",
        "frame": "https://www.example.com"
      },
      "expect": { "verdict": "deny", "reason": "default_deny" }
    },
    {
      "name": "third-party frame never inherits",
